# Paystack Live / Test API Keys
# Frontend Public Key (starts with pk_live_ for live transactions or pk_test_ for testing)
VITE_PAYSTACK_PUBLIC_KEY=pk_live_your_live_public_key_here

# Public HTTPS URL for the deployed Paystack payment server (no trailing slash).
VITE_PAYSTACK_API_BASE=https://your-payment-api.example.com

# Backend Secret Key (starts with sk_live_ for live transactions or sk_test_ for testing)
PAYSTACK_SECRET_KEY=sk_live_your_live_secret_key_here

# Paystack API Endpoint
PAYSTACK_API_URL=https://api.paystack.co

# MySQL database settings for live order and backup storage.
# Leave these unset if you want the app to run with the local JSON fallback only.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=samtuberg_store

# Verification Server Port
PORT=8787

# Exact public storefront origin allowed to call the verification server.
# Use FRONTEND_ORIGINS instead when allowing multiple origins (comma-separated).
# FRONTEND_ORIGINS overrides FRONTEND_ORIGIN when both are supplied.
FRONTEND_ORIGIN=https://your-storefront.example.com

# Required in production; use a unique admin account/password, not the local dev demo.
CATALOG_ADMIN_USERNAME=your_admin_username
CATALOG_ADMIN_PASSWORD=replace_with_a_long_unique_password

# Optional persistent catalog file path. The default is ./data/catalog-overrides.json.
# Use persistent disk storage and one server instance, or replace with a shared database.
# CATALOG_FILE=/var/lib/samtuberg/catalog-overrides.json
